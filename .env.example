# Copy to .env and fill in. .env is gitignored.

# Your own company. The model files documents as its CEO.
TIDY_COMPANY_NAME=Acme Corp

# Your own companies' names, as one regex alternation (case-insensitive).
TIDY_CORPORATE_TERMS=acme|globex\.?io

# Clients and projects, one line each: "Folder name = regex = note".
# Each gets a folder in Corporate (Corporate/<name>/<category>). A file goes there when the regex
# matches its filename or text; otherwise Corporate/_Internal. The regex and note are optional.
TIDY_CLIENT_INITECH=Initech = initech = payroll software platform
TIDY_CLIENT_HOOLI=Hooli = hooli =

# Company words matched in filenames only (too generic to trust in a document's text).
TIDY_CORPORATE_NAME_TERMS=payroll.?report|user.?stor(y|ies)
