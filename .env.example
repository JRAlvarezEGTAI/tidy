# Copy to .env and fill in. .env is gitignored.

# Your own company. The model files documents as its CEO.
TIDY_COMPANY_NAME=Acme Corp

# Your own companies' names, as one regex alternation (case-insensitive).
TIDY_CORPORATE_TERMS=acme|globex\.?io

# Clients and projects, one line each:
#   "Folder name = regex (filename and text) = note = regex (filename only)".
# Each gets a folder in Corporate (Corporate/<name>/<category>); files naming no client go to
# Corporate/_Internal. Everything after the name is optional. Generic words ("inventory") belong in
# the filename-only regex. Filenames are matched with _ - . turned into spaces: write a.?b, not a\.b.
TIDY_CLIENT_INITECH=Initech = initech = payroll software platform
TIDY_CLIENT_HOOLI=Hooli = hooli
TIDY_CLIENT_STOCK=Stockroom = stockroom = ERP project = inventory|item.?master

# Company words matched in filenames only (too generic to trust in a document's text).
TIDY_CORPORATE_NAME_TERMS=payroll.?report|user.?stor(y|ies)
